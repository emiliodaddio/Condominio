# ==========================================
# Configurazione Produzione Aruba
# ==========================================
DB_TYPE=mysql

# Credenziali MySQL fornite da Aruba (es. dall'email o pannello di controllo)
# Tipicamente l'host è simile a: mysql.nomedominio.ext oppure mysqlXXXX.aruba.it oppure 62.149.150.xxx
MYSQL_HOST=mysql.tuodominio.it
MYSQL_PORT=3306
MYSQL_USER=SqlXXXXXX
MYSQL_PASSWORD=LaTuaPasswordMySQLAruba
MYSQL_DATABASE=SqlXXXXXX_1

# Porta dell'applicazione
PORT=3000
NODE_ENV=production
